const std = @import("std");
const net = std.Io.net;
const print = std.debug.print;

fn sendIrcCommand(io: std.Io, stream: *net.Stream, comptime fmt: []const type, args: anytype) !void {
    var buffer: [512]u8 = undefined;
    var writer = stream.writer(io, &buffer);

    try writer.interface.print(fmt ++ "\r\n", args);
    try writer.interface.flush();
}

pub fn main(init: std.process.Init) !void {
    const io = init.io;

    const port = 6667;
    const host = "irc.ircnet.com";

    print("Initializing hostname lookup for: {s}:{d}\n", .{ host, port });

    const host_name = try net.HostName.init(host);
    var stream = try host_name.connect(io, port, .{ .mode = .stream });
    defer stream.close(io);

    print("Successfully connected via DNS hostname!\n", .{});

    sendIrcCommand(io, &stream, "NICK ilyeshdz");
    sendIrcCommand(io, &stream, "USER ilyeshdz 0 * :ilyeshdz");
    
    print("IRC command sent")
}
